generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?  @unique
  password  String
  avatar    String
  alias     String?
  createdAt DateTime @default(now())

  groups    GroupMember[]
  expenses  Expense[]
  messages  Message[]
  paymentsSent SettlementPayment[] @relation("PaymentsSent")
  paymentsReceived SettlementPayment[] @relation("PaymentsReceived")
  passwordResetTokens PasswordResetToken[]
}

model Group {
  id          String    @id @default(cuid())
  name        String
  emoji       String
  inviteCode  String    @unique @default(cuid())
  status      String    @default("active")
  eventDate   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  members     GroupMember[]
  expenses    Expense[]
  messages    Message[]
  settlementPayments SettlementPayment[]
}

model GroupMember {
  userId    String
  groupId   String
  joinedAt  DateTime @default(now())

  user      User  @relation(fields: [userId], references: [id])
  group     Group @relation(fields: [groupId], references: [id])

  @@id([userId, groupId])
}

model Expense {
  id        String   @id @default(cuid())
  desc      String
  amount    Float
  date      String
  createdAt DateTime @default(now())

  paidById  String
  groupId   String

  paidBy    User  @relation(fields: [paidById], references: [id])
  group     Group @relation(fields: [groupId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())

  userId    String
  groupId   String

  user      User  @relation(fields: [userId], references: [id])
  group     Group @relation(fields: [groupId], references: [id])
}

model SettlementPayment {
  id        String   @id @default(cuid())
  amount    Float
  createdAt DateTime @default(now())

  fromId    String
  toId      String
  groupId   String

  from      User  @relation("PaymentsSent", fields: [fromId], references: [id])
  to        User  @relation("PaymentsReceived", fields: [toId], references: [id])
  group     Group @relation(fields: [groupId], references: [id])
}
